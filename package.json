{
  "name": "mindee-ocr",
  "version": "4.1.0",
  "description": "Parse your document using the Mindee API.",
  "scripts": {
    "clean": "rimraf ./dist ./build",
    "build": "npm run clean && tsc",
    "test": "npm run build && vitest --run",
    "zapier": "npm run build && zapier-platform",
    "lint": "eslint  './src/**/*.ts' --report-unused-disable-directives && echo 'Your .ts files look good.'",
    "lint-fix": "eslint './src/**/*.ts' --fix"
  },
  "engines": {
    "node": "^22"
  },
  "dependencies": {
    "zapier-platform-cli": "18.2.3",
    "zapier-platform-core": "18.2.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "~3.3",
    "@eslint/js": "~10.0",
    "@typescript-eslint/eslint-plugin": "~8.57",
    "eslint": "~10.0",
    "globals": "~17.4",
    "mocha": "~11.7",
    "rimraf": "~6.1",
    "ts-node": "~10.9.2",
    "typescript": "~5.9",
    "vitest": "~3.2"
  },
  "overrides": {
    "@types/node": "^22"
  },
  "private": true,
  "exports": "./dist/index.js",
  "type": "module"
}
